{
  "name": "nullx11code",
  "version": "0.5.0",
  "description": "A focused, free-first coding workspace and terminal agent powered by OpenCode. Branded chat UI, approvals, model selection, project context and native agent tools.",
  "type": "module",
  "bin": {
    "nullx11code": "bin/nullx11code.js",
    "n11": "bin/nullx11code.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/nullx11code.js",
    "serve": "node bin/nullx11code.js serve",
    "test": "node --test test/*.test.js",
    "icons:png": "node scripts/gen-png-icons.js",
    "icons": "node scripts/gen-icons.js",
    "start:legacy": "node bin/nullx11code.js legacy",
    "serve:legacy": "node bin/nullx11code.js legacy serve",
    "test:browser": "playwright test"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "install.sh",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/OPENCODE.md",
    "docs/WORKSPACE.md",
    "docs/BRANDING.md"
  ],
  "keywords": [
    "ai",
    "cli",
    "agent",
    "coding-assistant",
    "nvidia",
    "nim",
    "groq",
    "openrouter",
    "llm",
    "terminal",
    "skills",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Inkflow-Gab/nullx11code.git"
  },
  "optionalDependencies": {
    "opencode-ai": "1.19.5"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "138.0.2"
  }
}
