# nullx11code — copy to `.env` (project) or ~/.nullx11code/.env (global)
# Keys are auto-detected; you only need ONE free provider to start.

# NVIDIA NIM — flagship free tier (https://build.nvidia.com)
NVIDIA_API_KEY=

# Groq — free tier, very fast (https://console.groq.com/keys)
GROQ_API_KEY=

# Cerebras — free developer tier (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# OpenRouter — hundreds of models, use `:free` ids (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Google Gemini — free Flash tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Mistral — free credits (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# GitHub Models — free with a fine-grained token (https://github.com/settings/tokens)
GITHUB_TOKEN=

# Optional paid extras
# OPENAI_API_KEY=
# TOGETHER_API_KEY=
